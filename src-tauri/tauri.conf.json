{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Nebo",
  "version": "0.1.1",
  "identifier": "org.opennebo.app",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Open Nebo", "width": 1200, "height": 800, "dragDropEnabled": false }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "fileAssociations": [
      { "ext": ["onb"], "mimeType": "application/vnd.opennebo+zip", "name": "Open Nebo notebook" }
    ]
  }
}
