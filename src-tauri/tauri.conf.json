{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Nebo",
  "version": "0.1.0",
  "identifier": "org.opennebo.app",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Open Nebo", "width": 1200, "height": 800 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "fileAssociations": [
      { "ext": ["nebo"], "mimeType": "application/vnd.myscript.nebo", "name": "Nebo notebook" }
    ]
  }
}
